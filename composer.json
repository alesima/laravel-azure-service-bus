{
    "name": "alesima/laravel-azure-service-bus",
    "version": "2.0.0",
    "description": "A Laravel Queue driver for Azure Service Bus (queues + topics/subscriptions, REST client included)",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Silva",
            "email": "alex@codingwithalex.com",
            "role": "developer"
        }
    ],
    "keywords": ["azure", "servicebus", "queue", "laravel", "topic", "pubsub"],
    "homepage": "https://github.com/alesima/laravel-azure-service-bus",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "illuminate/container": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/encryption": "^10.0|^11.0",
        "illuminate/queue": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "phpstan/phpstan": "^1.0|^2.0",
        "squizlabs/php_codesniffer": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Alesima\\LaravelAzureServiceBus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alesima\\LaravelAzureServiceBus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpcs --standard=.phpcs.xml src tests config",
        "format": "vendor/bin/phpcbf --standard=.phpcs.xml src tests config",
        "fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/phpunit --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-clover build/logs/clover.xml",
        "prepare": ["@lint", "@analyse"]
    },
    "extra": {
        "laravel": {
            "providers": ["Alesima\\LaravelAzureServiceBus\\Providers\\ServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
